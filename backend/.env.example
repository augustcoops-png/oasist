# Port the backend server listens on.
PORT=3000

# ── RPC endpoint pool ─────────────────────────────────────────────────────────
#
# SOLANA_RPC_URLS (recommended) — comma-separated list of Solana JSON-RPC
# endpoints.  The proxy round-robins across all listed nodes and automatically
# fails over to the next one whenever a node is unreachable.
#
# Leave unset to use the built-in public pool of 15 mainnet endpoints.
#
# Examples:
#   Single node:
#     SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com
#
#   Multiple nodes (round-robin + failover):
#     SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com,https://rpc.ankr.com/solana,https://solana.drpc.org
#
# Known free public mainnet endpoints (no API key required):
#   https://api.mainnet-beta.solana.com          (Solana Labs — official)
#   https://rpc.ankr.com/solana                  (Ankr)
#   https://solana-mainnet.rpc.extrnode.com       (Extrnode)
#   https://solana-rpc.publicnode.com             (PublicNode)
#   https://solana.drpc.org                       (dRPC)
#   https://endpoints.omniatech.io/v1/sol/mainnet/public  (Omnia)
#   https://1rpc.io/sol                           (1RPC by Automata)
#   https://mainnet.rpcpool.com                   (RPCPool)
#   https://solana.blockpi.network/v1/rpc/public  (BlockPI)
#   https://api.mainnet.rpcfast.com               (RPCFast)
#   https://solana.public-rpc.com                 (public-rpc.com)
#   https://solana-api.projectserum.com           (Project Serum)
#   https://ssc-dao.genesysgo.net                 (GenesysGo)
#   https://lb.drpc.org/ogrpc?network=solana      (Nodies / dRPC LB)
#   https://api.mainnet.solana.melea.xyz          (Melea Trust)
#
# SOLANA_RPC_URL (legacy, single URL) — used only when SOLANA_RPC_URLS is unset.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
#
# Devnet / Testnet alternatives:
#   SOLANA_RPC_URLS=https://api.devnet.solana.com,https://rpc.ankr.com/solana_devnet
#   SOLANA_RPC_URLS=https://api.testnet.solana.com
